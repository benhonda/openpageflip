---
/**
 * The install tabs: one per package manager (commands come from starlight-package-managers), then
 * a CDN tab holding the slot. starlight-package-managers can't take a tab of its own, so each
 * manager is rendered through it singly and the tabs are ours.
 */
import { TabItem, Tabs } from "@astrojs/starlight/components";
import type { ComponentProps } from "astro/types";
import { PackageManagers } from "starlight-package-managers";

interface Props {
  pkg: string;
}

const { pkg } = Astro.props;

const managers = [
  { name: "npm", icon: "seti:npm" },
  { name: "pnpm", icon: "pnpm" },
  { name: "yarn", icon: "seti:yarn" },
] as const satisfies { name: string; icon: ComponentProps<typeof TabItem>["icon"] }[];
---

{/* starlight-package-managers' own syncKey, so the choice carries to its tabs on other pages. */}
<Tabs syncKey="starlight-package-managers-pkg">
  {
    managers.map(({ name, icon }) => (
      <TabItem label={name} icon={icon}>
        <PackageManagers pkg={pkg} pkgManagers={[name]} />
      </TabItem>
    ))
  }
  <TabItem label="CDN" icon="seti:html">
    <slot />
  </TabItem>
</Tabs>
